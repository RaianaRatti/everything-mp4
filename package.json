    "@mediabunny/flac-encoder": "^1.65.2",
    "@mediabunny/mp3-encoder": "^1.65.2",
    "client-zip": "^2.5.1",
    "lucide-react": "^1.67.0",
    "mediabunny": "^1.65.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "zustand": "^5.0.16"
